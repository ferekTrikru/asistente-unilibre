{
  "hosting": {
    "target": "agente",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "icons/logo.png",
      "backend/**",
      "**/*.db",
      "**/*.py",
      "**/*.pdf",
      "**/*.docx",
      "**/venv/**",
      "**/qdrant_data/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
