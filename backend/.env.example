# Ollama local (instala desde https://ollama.com y corre 'ollama pull llama3.1:8b')
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Qdrant: si dejas QDRANT_URL vacío, se usa una base local embebida en ./qdrant_data
# (sirve para probar en tu máquina). Para producción, usa una instancia de Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_NAME=admisiones_unilibre

# Modelo de embeddings multilingüe (384 dimensiones, entiende español, corre en CPU, sin costo)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Orígenes permitidos para llamar a la API (separados por coma).
# Agrega aquí el dominio de Firebase Hosting cuando lo despliegues.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080

# Ruta del archivo SQLite donde se guardan las citas agendadas.
APPOINTMENTS_DB_PATH=data/appointments.db

# Correo de confirmación de cita. Sin ninguna de las dos opciones de abajo, el envío
# se simula (queda en el log del servidor) para poder probar el flujo sin credenciales.
#
# Opción A — SMTP con tu propia cuenta de Gmail (no requiere crear cuenta en nada más):
# 1. Activa la verificación en dos pasos en https://myaccount.google.com/security
# 2. Genera una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#    (elige "Correo" / "Otra"), copia el código de 16 caracteres.
# 3. Pon tu correo y esa clave abajo (NO tu contraseña normal de Gmail).
SMTP_USER=
SMTP_APP_PASSWORD=

# Opción B — Resend (https://resend.com): cuenta gratis + API key.
RESEND_API_KEY=
# Dirección remitente: usa onboarding@resend.dev para pruebas (no requiere verificar
# dominio) o tu propio dominio verificado en Resend para producción.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Universidad Libre — Admisiones Barranquilla

# Vapi (https://vapi.ai) — llamada de confirmación de cita con un agente de voz con IA.
# Sin estas tres variables, la llamada se simula (se registra en consola).
# 1. Crea una cuenta gratis en vapi.ai (trae créditos de prueba).
# 2. Crea un "Assistant" en el dashboard: define su primer mensaje, el modelo (LLM),
#    la voz, y restringe en su prompt lo que puede responder (mismas reglas que el
#    chat: confirmar/reprogramar/cancelar la cita, preguntas básicas de la base de
#    conocimiento, nunca inventar información). Copia su ID.
# 3. Compra o importa un número de teléfono en Vapi (Phone Numbers). Copia su ID.
# 4. En la configuración del asistente, agrega esta API como "Server URL" para
#    recibir eventos: <URL_PUBLICA_DE_ESTE_BACKEND>/webhooks/vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Clave del panel del asesor (screens/asesor/). Sin ella, el panel queda deshabilitado.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_API_KEY=

# Secreto que Vapi envía en x-vapi-secret (dashboard de Vapi > Server URL Secret).
# Sin él, el webhook /webhooks/vapi rechaza todo.
VAPI_WEBHOOK_SECRET=

# Máximo de peticiones por minuto por IP en las rutas públicas (0 = sin límite).
RATE_LIMIT_PER_MINUTE=20
